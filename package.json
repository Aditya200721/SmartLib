{
  "name": "smart-lib",
  "version": "1.0.0",
  "private": true,
  "description": "SMART LIB - Library Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node src/database/init.js",
    "db:seed": "node src/database/seed.js",
    "db:setup": "npm run db:init && npm run db:seed",
    "test": "node --test",
    "test:db": "node --test tests/database.test.js",
    "test:auth": "node --test tests/auth.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
